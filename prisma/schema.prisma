generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum JobStage {
  INITIALIZED
  GENERATING_STORY
  CREATING_STORY
  CREATING_MAIN_CHARS
  CREATING_SEC_CHARS
  CREATING_FIRST_SCENE
  GENERATING_BANNER
  UPLOADING_BANNER
  GENERATING_SCENE_IMG
  UPLOADING_SCENE_IMG
  FINALIZING
}

model Job {
  id          String    @id @default(cuid())
  status      JobStatus @default(PENDING)
  stage       JobStage? @default(INITIALIZED)
  progress    Int       @default(0)
  startedAt   DateTime? @default(now())
  completedAt DateTime?
  error       String?   @db.Text
  //
  input       Json
  //
  output      Json?
  //
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId     String?
  story       Story?    @relation(fields: [storyId], references: [id], onDelete: SetNull)
  //
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
  @@index([stage])
}

model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  // 
  daily_limit_messages Int?       @default(15)
  premium              Boolean    @default(false) // Can generate more than 15 messages per day and access to generate scenes and characters images and avatars
  //
  stories              Story[]
  gameSaves            GameSave[]
  // 
  jobs                 Job[]
  // 
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt
}

enum NarrativeStyle {
  FirstPerson
  SecondPerson
  ThirdPerson
}

model Story {
  id               String         @id @default(cuid())
  title            String
  synopsis         String         @db.Text
  goal             String         @db.Text
  possibleEndings  String[]
  coverImageUrl    String?
  genre            String[]
  narrativeStyle   NarrativeStyle
  //
  characters       Character[]
  // 
  scenes           Scene[]
  max_scenes       Int?           @default(20)
  current_scene    Int?           @default(0)
  current_scene_id String?
  // 
  gameSaves        GameSave[]
  creator          User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId        String
  // 
  jobs             Job[]
  // 
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  @@index([creatorId])
}

model Character {
  id               String           @id @default(cuid())
  name             String
  description      String           @db.Text
  personality      String?          @db.Text
  outfit           String?
  age              Int?
  background       String?          @db.Text
  abilities        String[]
  relationships    String[]
  motivations      String?
  flaws            String?
  backstory        String?          @db.Text
  isMain           Boolean          @default(false)
  imageUrl         String?
  //
  story            Story            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId          String
  sceneAppearances SceneCharacter[]
  // 
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  @@index([storyId])
}

model Scene {
  id                 String            @id @default(cuid())
  title              String
  content            String            @db.Text
  imagePrompt        String?           @db.Text
  imageUrl           String?
  order              Int               @default(0)
  //
  story              Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId            String
  // 
  choices            Choice[]
  selected_choice_id String?
  // 
  characters         SceneCharacter[]
  nextScenes         SceneTransition[] @relation("SourceScene")
  prevScenes         SceneTransition[] @relation("DestinationScene")
  // 
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  @@index([storyId])
}

model SceneTransition {
  id                 String   @id @default(cuid())
  sourceScene        Scene    @relation("SourceScene", fields: [sourceSceneId], references: [id], onDelete: Cascade)
  sourceSceneId      String
  destinationScene   Scene    @relation("DestinationScene", fields: [destinationSceneId], references: [id], onDelete: Cascade)
  destinationSceneId String
  choiceId           String
  choice             Choice   @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  // 
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([sourceSceneId, choiceId])
}

model SceneCharacter {
  id          String    @id @default(cuid())
  role        String?
  //
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId     String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId String
  // 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([sceneId, characterId])
}

model Choice {
  id             String            @id @default(cuid())
  text           String
  description    String?           @db.Text
  consequence    String?           @db.Text
  isPersonalized Boolean           @default(false)
  loadingMessage String?
  isCustomChoice Boolean           @default(false)
  //
  scene          Scene             @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId        String
  transitions    SceneTransition[]
  saveHistories  SaveHistory[]
  // 
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  @@index([sceneId])
}

model GameSave {
  id             String        @id @default(cuid())
  name           String        @default("Save")
  characterName  String
  characterClass String?
  lastPlayed     DateTime      @default(now())
  currentSceneId String
  progress       Int           @default(0)
  //
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  story          Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId        String
  // 
  history        SaveHistory[]
  notes          String?       @db.Text
  // 
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([userId])
  @@index([storyId])
}

model SaveHistory {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  //
  gameSave   GameSave @relation(fields: [gameSaveId], references: [id], onDelete: Cascade)
  gameSaveId String
  sceneId    String
  choiceId   String?
  choice     Choice?  @relation(fields: [choiceId], references: [id])
  // 
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([gameSaveId])
}
