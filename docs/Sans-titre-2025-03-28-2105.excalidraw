    {
      "id": "Kb413CPRQACatYdrkywTu",
      "type": "text",
      "x": 2028.8835737841146,
      "y": -609.302609809483,
      "width": 391.05343238891794,
      "height": 97.48270263560099,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
