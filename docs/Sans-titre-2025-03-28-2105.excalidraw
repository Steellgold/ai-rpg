    {
      "id": "FsT9SbBw-sw_00qwBuU73",
      "type": "text",
      "x": 1225.7578026203207,
      "y": 678.119259165327,
      "width": 426.9756164550781,
      "height": 180,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 2130487586,
      "version": 704,
      "versionNonce": 24686462,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1743192328617,
      "link": null,
      "locked": false,
      "text": "Le contexte de l'histoire et des personnages, les\nprécédents choix ainsi que le choix validé incluant son\ntitre et son descriptif sont envoyé à l'IA pour avoir la\nsuite de l'histoire\n\nL'IA va devoir générer la prochaine étape, les choix du\nprochain joueur. Si l'emplacement de l'histoire a changer\nalors une nouvelle image sera généré qui donne un\ncontexte visuel au joueur(s)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ekEpiZJm_6G4WGVJwbtcT",
      "originalText": "Le contexte de l'histoire et des personnages, les précédents choix ainsi que le choix validé incluant son\ntitre et son descriptif sont envoyé à l'IA pour avoir la suite de l'histoire\n\nL'IA va devoir générer la prochaine étape, les choix du prochain joueur. Si l'emplacement de l'histoire a changer alors une nouvelle image sera généré qui donne un contexte visuel au joueur(s)",
      "autoResize": true,
      "lineHeight": 1.25
    },
