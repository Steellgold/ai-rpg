model CreditPackage {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  credits     Int
  price       Float
  currency    String   @default("EUR")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([credits])
} 