generator client {
  provider        = "prisma-client-js"
  output          = "../generated"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum JobStage {
  INITIALIZED
  DETECTING_LANGUAGE
  GENERATING_STORY
  CREATING_STORY
  CREATING_MAIN_CHARS
  CREATING_SEC_CHARS
  CREATING_FIRST_SCENE
  GENERATING_ITEMS
  GENERATING_BANNER
  UPLOADING_BANNER
  GENERATING_SCENE_IMG
  UPLOADING_SCENE_IMG
  FINALIZING
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum ItemType {
  WEAPON
  ARMOR
  POTION
  KEY
  TOOL
  DOCUMENT
  QUEST
  MISC
}

enum StoryLanguage {
  auto
  en
  fr
  es
  it
  de
}

enum NarrativeStyle {
  FirstPerson
  SecondPerson
  ThirdPerson
}

enum StoryVGenerated {
  V1
  V2
  V3
}

enum TransactionType {
  PURCHASE
  SUBSCRIPTION
  USAGE
  REFUND
  BONUS
  ADMIN_ADJUST
}
